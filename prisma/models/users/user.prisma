// USER SYSTEM
model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String?
  googleId String? @unique

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  emailVerified     Boolean @default(false)
  verificationToken String? @unique

  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?
  isOnline             Boolean   @default(false)
  lastSeen             DateTime?

  createdAt DateTime @default(now())

  refreshTokens RefreshToken[]
  cart          Cart?
  addresses     Address[]
  orders        Order[]
  reviews       ProductReview[]
  wishlist      Wishlist?

  idempotencyKeys IdempotencyKey[]

  auditLogs                AuditLog[]
  createdCoupons           Coupon[]                  @relation("CouponCreatedBy")
  updatedCoupons           Coupon[]                  @relation("CouponUpdatedBy")
  couponAuditLogs          CouponAuditLog[]          @relation("CouponAuditAdmin")

  couponUsages        CouponUsage[]
  couponReservations  CouponReservation[]
  couponCustomerRules CouponCustomerRule[]
  checkoutSessions CheckoutSession[]

  //////////////////////////////////////////////////////
  // MESSAGES
  //////////////////////////////////////////////////////
  messages     Message[]
  messageReads MessageRead[]
  messageAttachments MessageAttachment[]

  //////////////////////////////////////////////////////
  // CONVERSATIONS
  //////////////////////////////////////////////////////

  conversationParticipants ConversationParticipant[]
  customerConversations Conversation[] @relation("CustomerConversations")
  assignedConversations Conversation[] @relation("AssignedConversations")
  createdConversations Conversation[] @relation("ConversationCreator")
  deletedConversations Conversation[] @relation("ConversationDeletor")
  archivedConversations Conversation[] @relation("ConversationArchived")
  lastMessageConversations Conversation[] @relation("ConversationLastMessageSender")
  conversationEvents ConversationEvent[]

  //////////////////////////////////////////////////////
  // SUPPORT TEAMS
  //////////////////////////////////////////////////////

  supportTeamMemberships SupportTeamMember[]
  supportTeamEvents SupportTeamEvent[] @relation("SupportTeamEventUser")
  supportTeamActions SupportTeamEvent[] @relation("SupportTeamEventActor")
  createdSupportTeams SupportTeam[] @relation("SupportTeamCreator")
  notifications Notification[] @relation("UserNotifications")
  sentNotifications Notification[] @relation("NotificationSender")

  userPresences UserPresence?
  userPresenceSessions UserPresenceSession[]
}


// USER PROFILE
model Address {
  id     String @id @default(uuid())
  userId String

  name   String
  phone  String

  stateId String
  lgaId   String
  city    String

  area        String?
  street      String
  landmark    String?
  fullAddress String @db.Text

  isDefault Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  state State @relation(fields: [stateId], references: [id])
  lga   LGA   @relation(fields: [lgaId], references: [id])

  @@index([userId])
  @@index([stateId, lgaId])
}

model Wishlist {
  id     String @id @default(uuid())
  userId String @unique

  user  User           @relation(fields: [userId], references: [id])
  items WishlistItem[]

  createdAt DateTime @default(now())
}

model WishlistItem {
  id         String @id @default(uuid())
  wishlistId String
  productId  String

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([wishlistId, productId])
}
model Feedback {
  id               String           @id @default(uuid())
  userName         String?
  email            String
  phoneNumber      String?
  productName      String
  productNumber    String?
  usageDuration    String?
  buyAgain         String?
  buyingExperience Int              @default(0)
  concern          String?
  ratings          FeedbackRating[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model FeedbackRating {
  id         String   @id @default(uuid())
  feedbackId String
  criteria   String
  score      Int
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}
