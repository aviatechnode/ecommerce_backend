model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  // SHIPPING INPUT (used to compute zone)
  deliveryStateId String?
  deliveryLgaId   String?
  deliveryState State? @relation(fields: [deliveryStateId], references: [id])
  deliveryLga   LGA?   @relation(fields: [deliveryLgaId], references: [id])
  // PRICING CACHE (computed value only)
  subtotal             Decimal? @db.Decimal(12, 2)
  estimatedDeliveryFee Decimal? @db.Decimal(12, 2)

  items     CartItem[]
  checkoutSessions CheckoutSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deliveryStateId])
  @@index([deliveryLgaId])
}

model CartItem {
  id        String @id @default(uuid())

  cartId    String
  variantId String

  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  cart      Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

// ORDERS

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique

  userId      String
  user        User   @relation(fields: [userId], references: [id])

  status        OrderStatus
  paymentStatus PaymentStatus

  subtotal      Decimal @db.Decimal(12, 2)
  deliveryFee   Decimal @db.Decimal(12, 2)
  totalAmount   Decimal @db.Decimal(12, 2)

  currency      String @default("NGN")

  deliveryStateId String
  deliveryLgaId   String

  addressSnapshot Json

  orderItems OrderItem[]
  payment Payment?
  stockReservations StockReservation[]

  orderEvents OrderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, paymentStatus])
}

model OrderItem {
  id            String              @id @default(uuid())
  orderId       String
  variantId     String
  productName   String
  variantName   String
  sku           String
  unitPrice     Decimal             @db.Decimal(12, 2)
  quantity      Int
  refunds       Refund[]
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant       ProductVariant      @relation(fields: [variantId], references: [id])
}

model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  type      String
  message   String?
  metadata  Json?
  order     Order    @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
}

model CheckoutSession {
  id String @id @default(uuid())

  cartId String
  userId String

  cart Cart @relation(fields: [cartId], references: [id])
  user User @relation(fields: [userId], references: [id])

  subtotal     Decimal @db.Decimal(12, 2)
  deliveryFee  Decimal @db.Decimal(12, 2)
  totalAmount  Decimal @db.Decimal(12, 2)

  deliveryStateId String?
  deliveryLgaId   String?

  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}