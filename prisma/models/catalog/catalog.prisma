// CATALOG
model Category {
  id String @id @default(uuid())

  name String
  slug String @unique

  code        String  @unique
  type        String
  level       Int     @default(0)
  description String?
  imageUrl    String?
  sortOrder   Int     @default(0)

  isActive Boolean @default(true)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products Product[]

  couponCategoryRules CouponCategoryRule[]
}

model Brand {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  logoUrl     String?
  description String?
  isFeatured  Boolean @default(false)

  products Product[]
}

model Product {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  brandId    String
  categoryId String

  isActive       Boolean @default(true)
  searchKeywords String?
  isFeatured     Boolean @default(false)
  viewCount      Int     @default(0)
  soldCount      Int     @default(0)

  brand    Brand    @relation(fields: [brandId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  oemNumbers     ProductOEM[]
  variants       ProductVariant[]
  medias         ProductMedia[]
  specifications ProductSpecification[]
  reviews        ProductReview[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  productFitments      ProductFitment[]
  wishlistItems        WishlistItem[]
  productSearchIndexes ProductSearchIndex[]
  couponProductRules   CouponProductRule[]
  fitmentIndexes       FitmentIndex[]

  @@index([brandId])
  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
}

model ProductVariant {
  id   String @id @default(uuid())
  name String
  sku  String @unique

  price     Decimal  @db.Decimal(12, 2)
  costPrice Decimal? @db.Decimal(12, 2)

  weight Float?
  length Float?
  width  Float?
  height Float?

  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  isActive       Boolean  @default(true)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  barcode        String?  @unique

  inventories ProductInventory[]
  attributes  VariantAttribute[]

  cartItems  CartItem[]
  orderItems OrderItem[]

  inventoryMovements InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  stockReservations  StockReservation[]

  @@index([productId])
}

model ProductMedia {
  id        String @id @default(uuid())
  productId String

  url      String
  type     MediaType
  position Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
}

model ProductSpecification {
  id        String @id @default(uuid())
  productId String

  name  String
  value String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductOEM {
  id String @id @default(uuid())

  productId String
  oemNumber String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, oemNumber])
  @@index([oemNumber])
}

model ProductReview {
  id String @id @default(uuid())

  userId    String
  productId String

  title   String?
  rating  Int
  comment String?

  verifiedPurchase Boolean @default(false)
  isApproved       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
}

model ProductSearchIndex {
  id String @id @default(uuid())

  productId String @unique

  searchableText String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////////
// ATTRIBUTES
//////////////////////////////////////////////////////////

model Attribute {
  id   String @id @default(uuid())
  name String
  slug String @unique

  values AttributeValue[]
}

model AttributeValue {
  id          String @id @default(uuid())
  attributeId String

  value String

  attribute Attribute          @relation(fields: [attributeId], references: [id])
  variants  VariantAttribute[]
}

model VariantAttribute {
  id String @id @default(uuid())

  variantId String
  valueId   String

  variant ProductVariant @relation(fields: [variantId], references: [id])
  value   AttributeValue @relation(fields: [valueId], references: [id])

  @@unique([variantId, valueId])
}

// VEHICLE MAKE
model VehicleMake {
  id              String           @id @default(uuid())
  name            String           @unique
  slug            String           @unique
  isActive        Boolean          @default(true)
  models          VehicleModel[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  productFitments ProductFitment[]

  @@index([isActive])
}

// VEHICLE MODEL
model VehicleModel {
  id              String              @id @default(uuid())
  makeId          String
  name            String
  slug            String
  isActive        Boolean             @default(true)
  make            VehicleMake         @relation(fields: [makeId], references: [id], onDelete: Cascade)
  generations     VehicleGeneration[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  productFitments ProductFitment[]

  @@unique([makeId, name])
  @@unique([makeId, slug])
  @@index([makeId])
  @@index([isActive])
}

// VEHICLE GENERATION
model VehicleGeneration {
  id              String           @id @default(uuid())
  modelId         String
  name            String
  slug            String?
  chassisCode     String?
  yearStart       Int
  yearEnd         Int?
  isActive        Boolean          @default(true)
  model           VehicleModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  engines         VehicleEngine[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  productFitments ProductFitment[]

  @@unique([modelId, name])
  @@index([modelId])
  @@index([yearStart, yearEnd])
  @@index([isActive])
  @@index([chassisCode])
}

// VEHICLE ENGINE
model VehicleEngine {
  id                String            @id @default(uuid())
  generationId      String
  engineCode        String
  engineName        String?
  fuelType          String?
  aspiration        String?
  cylinders         Int?
  horsepower        Int?
  displacementCc    Int?
  displacementLabel String?
  drivetrain        String?
  transmissionType  String?
  isActive          Boolean           @default(true)
  generation        VehicleGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  trims             VehicleTrim[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  productFitments   ProductFitment[]

  @@unique([generationId, engineCode])
  @@index([generationId])
  @@index([engineCode])
  @@index([fuelType])
  @@index([isActive])
}

// VEHICLE TRIM
model VehicleTrim {
  id              String           @id @default(uuid())
  engineId        String
  name            String
  bodyType        String?
  doors           Int?
  isActive        Boolean          @default(true)
  engine          VehicleEngine    @relation(fields: [engineId], references: [id], onDelete: Cascade)
  productFitments ProductFitment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([engineId, name])
  @@index([engineId])
  @@index([isActive])
}

//////////////////////////////////////////////////////////
// FITMENT INDEX
//////////////////////////////////////////////////////////

model FitmentIndex {
  id String @id @default(uuid())

  productId String

  //////////////////////////////////////////////////////
  // DENORMALIZED SEARCHABLE DATA
  //////////////////////////////////////////////////////

  makeId String?
  make   String

  modelId String?
  model   String

  generationId String?
  generation   String?

  engineId       String?
  engineCode     String?
  trimId         String?
  trim           String?
  year           Int
  searchableText String?
  createdAt      DateTime @default(now())
  // RELATIONS
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, make, model, year, engineCode])
  // INDEXES
  @@index([productId])
  @@index([make])
  @@index([model])
  @@index([year])
  @@index([make, model, year])
  @@index([makeId, modelId])
  @@index([generationId])
  @@index([engineId])
  @@index([trimId])
}

// PRODUCT FITMENT
model ProductFitment {
  id        String       @id @default(uuid())
  // PRODUCT
  productId String
  // FITMENT LEVEL
  level     FitmentLevel
  // TARGETS
  makeId    String?

  modelId String?

  generationId String?

  engineId String?

  trimId    String?
  // RANGE SUPPORT
  yearStart Int?
  yearEnd   Int?
  // EXTRA FITMENT DATA
  notes     String?

  position         String?
  quantityRequired Int?

  isUniversal Boolean            @default(false)
  // RELATIONS
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  make        VehicleMake?       @relation(fields: [makeId], references: [id])
  model       VehicleModel?      @relation(fields: [modelId], references: [id])
  generation  VehicleGeneration? @relation(fields: [generationId], references: [id])
  engine      VehicleEngine?     @relation(fields: [engineId], references: [id])
  trim        VehicleTrim?       @relation(fields: [trimId], references: [id])
  // AUDIT
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // PREVENT DUPLICATES
  @@unique([productId, level, makeId, modelId, generationId, engineId, trimId, yearStart, yearEnd])
  // INDEXES
  @@index([productId])
  @@index([level])
  @@index([makeId])
  @@index([modelId])
  @@index([generationId])
  @@index([engineId])
  @@index([trimId])
  @@index([yearStart, yearEnd])
  @@index([isUniversal])
}
