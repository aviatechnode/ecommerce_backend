// RBAC SYSTEM
model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  parentId String?
  parent   Role?   @relation("RoleHierarchy", fields: [parentId], references: [id])
  children Role[]  @relation("RoleHierarchy")

  users                User[]
  rolePermissions      RolePermission[]
  rolePermissionGroups RolePermissionGroup[]
  supportTeamMemberships SupportTeamMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  resource String
  action   String

  rolePermissions       RolePermission[]
  permissionAssignments PermissionAssignment[]

  createdAt DateTime @default(now())

  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model PermissionGroup {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  rolePermissionGroups  RolePermissionGroup[]
  permissionAssignments PermissionAssignment[]
}

model RolePermissionGroup {
  roleId  String
  groupId String

  role  Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  group PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([roleId, groupId])
}

model PermissionAssignment {
  groupId      String
  permissionId String

  group      PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([groupId, permissionId])
}

model RefreshToken {
  id           String  @id @default(uuid())
  token        String  @unique
  userId       String
  
  userAgent String?
  ipAddress String?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique
  userId    String
  response  Json?
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String  @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  userAgent String?
  metadata  Json?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}
