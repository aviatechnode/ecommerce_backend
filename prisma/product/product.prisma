
model Product {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  brandId    String
  categoryId String

  isActive       Boolean @default(true)
  searchKeywords String?
  isFeatured     Boolean @default(false)
  viewCount      Int     @default(0)
  soldCount      Int     @default(0)

  brand    Brand    @relation(fields: [brandId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  oemNumbers     ProductOEM[]
  variants       ProductVariant[]
  medias         ProductMedia[]
  specifications ProductSpecification[]
  reviews        ProductReview[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  productFitments      ProductFitment[]
  wishlistItems        WishlistItem[]
  productSearchIndexes ProductSearchIndex[]
  couponProductRules   CouponProductRule[]
  fitmentIndexes       FitmentIndex[]

  @@index([brandId])
  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
  fitmentResolutionLogs FitmentResolutionLog[]
}

model ProductVariant {
  id   String @id @default(uuid())
  name String
  sku  String @unique

  price     Decimal  @db.Decimal(12, 2)
  costPrice Decimal? @db.Decimal(12, 2)

  weight Float?
  length Float?
  width  Float?
  height Float?

  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  isActive       Boolean  @default(true)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  barcode        String?  @unique

  inventories ProductInventory[]
  attributes  VariantAttribute[]

  cartItems  CartItem[]
  orderItems OrderItem[]

  inventoryMovements InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  stockReservations  StockReservation[]

  @@index([productId])
}

model ProductMedia {
  id        String @id @default(uuid())
  productId String

  url      String
  type     MediaType
  position Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
}

model ProductSpecification {
  id        String @id @default(uuid())
  productId String

  name  String
  value String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductOEM {
  id String @id @default(uuid())

  productId String
  oemNumber String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, oemNumber])
  @@index([oemNumber])
}

model ProductReview {
  id String @id @default(uuid())

  userId    String
  productId String

  title   String?
  rating  Int
  comment String?

  verifiedPurchase Boolean @default(false)
  isApproved       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
}

model ProductSearchIndex {
  id String @id @default(uuid())

  productId String @unique

  searchableText String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////////
// ATTRIBUTES
//////////////////////////////////////////////////////////

model Attribute {
  id   String @id @default(uuid())
  name String
  slug String @unique

  values AttributeValue[]
}

model AttributeValue {
  id          String @id @default(uuid())
  attributeId String

  value String

  attribute Attribute          @relation(fields: [attributeId], references: [id])
  variants  VariantAttribute[]
}

model VariantAttribute {
  id String @id @default(uuid())

  variantId String
  valueId   String

  variant ProductVariant @relation(fields: [variantId], references: [id])
  value   AttributeValue @relation(fields: [valueId], references: [id])

  @@unique([variantId, valueId])
}

