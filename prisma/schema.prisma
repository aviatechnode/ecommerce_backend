generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////////
// RBAC SYSTEM
//////////////////////////////////////////////////////////

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  parentId    String?
  parent      Role?    @relation("RoleHierarchy", fields: [parentId], references: [id])
  children    Role[]   @relation("RoleHierarchy")

  users       User[]
  rolePermissions RolePermission[]
  rolePermissionGroups RolePermissionGroup[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  resource    String
  action      String

  rolePermissions       RolePermission[]
  permissionAssignments PermissionAssignment[]

  createdAt DateTime @default(now())

  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model PermissionGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  rolePermissionGroups RolePermissionGroup[]
  permissionAssignments PermissionAssignment[]
}

model RolePermissionGroup {
  roleId  String
  groupId String

  role  Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  group PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([roleId, groupId])
}

model PermissionAssignment {
  groupId      String
  permissionId String

  group        PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([groupId, permissionId])
}

//////////////////////////////////////////////////////////
// USER SYSTEM
//////////////////////////////////////////////////////////

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String?
  googleId  String?  @unique

  roleId     String
  role       Role @relation(fields: [roleId], references: [id])

  emailVerified Boolean @default(false)
  verificationToken String?

  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  isOnline Boolean @default(false)
  lastSeen DateTime?

  createdAt DateTime @default(now())

  refreshTokens RefreshToken[]
  cart          Cart?
  addresses     Address[]
  orders        Order[]
  reviews       ProductReview[]
  wishlist      Wishlist?

  idempotencyKeys IdempotencyKey[]

  notifications Notification[]
  auditLogs AuditLog[]
  messages Message[]
  conversationParticipants ConversationParticipant[]

  couponUsages CouponUsage[]
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  csrfPrevHash String?

  csrfHash   String

  userAgent  String?
  ipAddress  String?

  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////////
// USER PROFILE
//////////////////////////////////////////////////////////

model Address {
  id     String @id @default(uuid())
  userId String

  name   String
  phone  String

  state NigerianState
  lga   String
  city  String

  area  String?

  street String

  landmark String?

  fullAddress String @db.Text

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([state, lga])
}

model Wishlist {
  id     String @id @default(uuid())
  userId String @unique

  user  User           @relation(fields: [userId], references: [id])
  items WishlistItem[]

  createdAt DateTime @default(now())
}

model WishlistItem {
  id         String @id @default(uuid())
  wishlistId String
  productId  String

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([wishlistId, productId])
}

//////////////////////////////////////////////////////////
// CATALOG
//////////////////////////////////////////////////////////

model Category {
  id   String @id @default(uuid())

  name String
  slug String @unique

  code String @unique
  type String
  level Int @default(0)
  description String?
  imageUrl String?
  sortOrder Int @default(0)

  isActive Boolean @default(true)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products Product[]
}

model Brand {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique
  logoUrl String?
  description String?
  isFeatured Boolean @default(false)

  products Product[]
}

model Product {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  brandId    String
  categoryId String


  isActive Boolean @default(true)
  searchKeywords String?
  isFeatured Boolean @default(false)
  

  brand    Brand    @relation(fields: [brandId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  viewCount Int @default(0)
  soldCount Int @default(0)

  oemNumbers     ProductOEM[]
  variants       ProductVariant[]
  medias         ProductMedia[]
  specifications ProductSpecification[]
  reviews        ProductReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  productFitments ProductFitment[]
  wishlistItems WishlistItem[]
  productSearchIndexes ProductSearchIndex[]
  
  @@index([brandId])
  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
}

model ProductVariant {
  id        String @id @default(uuid())
  name String
  sku  String @unique

  price     Decimal @db.Decimal(12,2)
  costPrice Decimal? @db.Decimal(12,2)

  weight Float?
  length Float?
  width  Float?
  height Float?

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  isActive Boolean @default(true)
  compareAtPrice Decimal? @db.Decimal(12,2)
  barcode String? @unique

  inventories ProductInventory[]
  attributes  VariantAttribute[]

  cartItems  CartItem[]
  orderItems OrderItem[]

  inventoryMovements InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ProductMedia {
  id        String @id @default(uuid())
  productId String

  url      String
  type     MediaType
  position Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, position])
}

model ProductSpecification {
  id        String @id @default(uuid())
  productId String

  name  String
  value String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductOEM {
  id String @id @default(uuid())

  productId String
  oemNumber String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, oemNumber])
  @@index([oemNumber])
}

model ProductReview {
  id String @id @default(uuid())

  userId    String
  productId String

  title   String?
  rating  Int
  comment String?

  verifiedPurchase Boolean @default(false)
  isApproved       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
}
model ProductSearchIndex {
  id String @id @default(uuid())

  productId String @unique

  searchableText String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////////
// ATTRIBUTES
//////////////////////////////////////////////////////////

model Attribute {
  id   String @id @default(uuid())
  name String
  slug String @unique

  values AttributeValue[]
}

model AttributeValue {
  id          String @id @default(uuid())
  attributeId String

  value String

  attribute Attribute @relation(fields: [attributeId], references: [id])
  variants  VariantAttribute[]
}

model VariantAttribute {
  id String @id @default(uuid())

  variantId String
  valueId   String

  variant ProductVariant @relation(fields: [variantId], references: [id])
  value   AttributeValue @relation(fields: [valueId], references: [id])
  @@unique([variantId, valueId])
}

//////////////////////////////////////////////////////////
// VEHICLE FITMENT
//////////////////////////////////////////////////////////

model VehicleMake {
  id   String @id @default(uuid())
  name String @unique

  models VehicleModel[]
}

model VehicleModel {
  id     String @id @default(uuid())
  makeId String
  name   String

  make VehicleMake @relation(fields: [makeId], references: [id])

  generations VehicleGeneration[]
   @@unique([makeId, name])
}

model VehicleGeneration {
  id      String @id @default(uuid())
  modelId String

  name String

  yearStart Int
  yearEnd   Int?

  model VehicleModel @relation(fields: [modelId], references: [id])

  engines VehicleEngine[]
  @@unique([modelId, name])
}

model VehicleEngine {
  id           String @id @default(uuid())
  generationId String

  engineCode   String
  displacement String?

  generation VehicleGeneration @relation(fields: [generationId], references: [id])

  trims VehicleTrim[]
  @@unique([generationId, engineCode])
}

model VehicleTrim {
  id       String @id @default(uuid())
  engineId String

  name String

  engine VehicleEngine @relation(fields: [engineId], references: [id])

  productFitments ProductFitment[]
  @@unique([engineId, name])
}

model FitmentIndex {
  id String @id @default(uuid())

  productId String

  make  String
  model String
  year  Int

  createdAt DateTime @default(now())

  @@unique([productId, make, model, year])
}

model ProductFitment {
  id String @id @default(uuid())

  productId String
  trimId    String

  notes String?

  product Product     @relation(fields: [productId], references: [id])
  trim    VehicleTrim @relation(fields: [trimId], references: [id])
  @@unique([productId, trimId])
}

//////////////////////////////////////////////////////////
// INVENTORY
//////////////////////////////////////////////////////////

model Warehouse {
  id   String @id @default(uuid())
  name String

  state NigerianState
  city  String

  inventories ProductInventory[]
  routes      WarehouseRoute[]

  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductInventory {
  id String @id @default(uuid())

  variantId   String
  warehouseId String

  stock    Int @default(0)
  reserved Int @default(0)

  threshold Int?

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  @@unique([variantId, warehouseId])
}

model InventoryMovement {
  id String @id @default(uuid())

  variantId   String
  warehouseId String

  type     InventoryMovementType
  quantity Int

  note String?

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())
}

model StockReservation {
  id String @id @default(uuid())

  variantId   String
  warehouseId String
  orderId     String?

  quantity Int

  status StockReservationStatus @default(RESERVED)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId, warehouseId])
  @@index([orderId])
}

model WarehouseRoute {
  id String @id @default(uuid())

  warehouseId String
  state       NigerianState

  priority Int

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
}

//////////////////////////////////////////////////////////
// PROCUREMENT
//////////////////////////////////////////////////////////

model Supplier {
  id   String @id @default(uuid())
  name String

  email String?
  phone String?

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id String @id @default(uuid())

  supplierId String

  status PurchaseOrderStatus

  totalAmount Decimal

  supplier Supplier @relation(fields: [supplierId], references: [id])

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
}

model PurchaseOrderItem {
  id String @id @default(uuid())

  purchaseOrderId String
  variantId       String

  quantity  Int
  costPrice Decimal

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])
}

//////////////////////////////////////////////////////////
// CART
//////////////////////////////////////////////////////////

model Cart {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id])

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id String @id @default(uuid())

  cartId    String
  variantId String

  quantity Int

  unitPrice Decimal @db.Decimal(12,2)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

//////////////////////////////////////////////////////////
// ORDERS
//////////////////////////////////////////////////////////

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique

  userId String

  status        OrderStatus
  paymentStatus PaymentStatus

  subtotal    Decimal @db.Decimal(12,2)
  deliveryFee Decimal @db.Decimal(12,2)
  totalAmount Decimal @db.Decimal(12,2)

  currency String @default("NGN")

  couponId String?

  user   User   @relation(fields: [userId], references: [id])
  coupon Coupon? @relation(fields: [couponId], references: [id])

  items  OrderItem[]
  events OrderEvent[]

  address  OrderAddress?
  payment  Payment?
  shipment Shipment?
  discountAmount Decimal @default(0)

  createdAt DateTime @default(now())
}

model OrderItem {
  id String @id @default(uuid())

  orderId   String
  variantId String

  productName String
  variantName String
  sku         String

  unitPrice Decimal @db.Decimal(12,2)

  quantity Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])
}

model OrderEvent {
  id String @id @default(uuid())

  orderId String

  type String
  message String?

  metadata Json?

  order Order @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
}

model OrderAddress {
  id String @id @default(uuid())

  orderId String @unique

  name  String
  phone String

  state NigerianState
  lga   String
  city  String

  area String?

  street String

  landmark String?

  fullAddress String @db.Text

  order Order @relation(fields: [orderId], references: [id])
}
//////////////////////////////////////////////////////////
// PAYMENTS
//////////////////////////////////////////////////////////
model Payment {
  id String @id @default(uuid())

  orderId String @unique

  reference String @unique

  amount Decimal @db.Decimal(12,2)

  status PaymentStatus

  paidAt DateTime?

  order Order @relation(fields: [orderId], references: [id])

  refunds Refund[]
  transactions PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reference])
  @@index([status])
}

model PaymentTransaction {
  id String @id @default(uuid())

  paymentId String

  eventType String
  payload   Json

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([eventType])
  @@index([createdAt])
}

model Refund {
  id String @id @default(uuid())
  paymentId String

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount Decimal @db.Decimal(12,2)

  orderItemId String?
  quantity Int?

  reason String?

  status RefundStatus @default(PENDING)
  reference String? @unique

  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}


model ReturnRequest {
  id String @id @default(uuid())

  orderId String
  userId  String

  status RefundStatus @default(PENDING)

  reason String?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


//////////////////////////////////////////////////////////
// SHIPPING
//////////////////////////////////////////////////////////

model Courier {
  id   String @id @default(uuid())
  name String @unique

  phone   String?
  website String?

  shippingRates ShippingRate[]
  shipments     Shipment[]
  shippingZones ShippingZone[]

  createdAt DateTime @default(now())
}

model ShippingRate {
  id String @id @default(uuid())

  courierId String

  originState      NigerianState
  destinationState NigerianState

  baseFee  Decimal @db.Decimal(12,2)
  perKgFee Decimal @db.Decimal(12,2)
  perKmFee Decimal @db.Decimal(12,2)

  courier Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([originState, destinationState])
  @@index([courierId])
}

model ShippingZone {
  id String @id @default(uuid())

  courierId String

  state NigerianState
  lga   String?

  courier Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([state])
}

model StateDistance {
  id String @id @default(uuid())

  originState      NigerianState
  destinationState NigerianState

  distanceKm Float

  createdAt DateTime @default(now())

  @@unique([originState, destinationState])
}

model Shipment {
  id String @id @default(uuid())

  orderId String @unique

  courierId String?

  trackingNo String? @unique

  status ShipmentStatus

  shippedAt   DateTime?
  deliveredAt DateTime?

  order   Order   @relation(fields: [orderId], references: [id])
  courier Courier? @relation(fields: [courierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackingNo])
}
//////////////////////////////////////////////////////////
// MARKETING
//////////////////////////////////////////////////////////

model Coupon {
  id   String @id @default(uuid())
  code String @unique

  type  CouponType
  value Decimal @db.Decimal(12,2)

  minOrder Decimal? @db.Decimal(12,2)

  usageLimit Int?
  usedCount  Int @default(0)

  perUserLimit Int? @default(1) 
  expiresAt DateTime?
  isActive Boolean @default(true)
  usages CouponUsage[]

  orders Order[]
}

model CouponUsage {
  id String @id @default(uuid())

  couponId String
  userId   String

  orderId String?

  usedAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, orderId])
  @@index([couponId, userId])
}


//////////////////////////////////////////////////////////
// OPERATIONS
//////////////////////////////////////////////////////////

model IdempotencyKey {
  id String @id @default(uuid())

  key String @unique

  userId String

  response Json?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(uuid())

  userId String

  action   String
  entity   String
  entityId String?
  ipAddress String?
  userAgent String?
  metadata Json?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

//////////////////////////////
// NOTIFICATIONS
//////////////////////////////

model Notification {
  id String @id @default(uuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType
  title String
  message String

  isRead Boolean @default(false)

  entityType String?   // ORDER, PAYMENT, SHIPMENT, SYSTEM
  entityId   String?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([entityType, entityId])
}

model DashboardSnapshot {
  id String @id @default(uuid())

  date DateTime @unique

  totalRevenue Decimal
  totalOrders  Int
  totalUsers   Int

  createdAt DateTime @default(now())
}


//////////////////////////////
// Chat
//////////////////////////////

model Conversation {
  id String @id @default(uuid())

  status ConversationStatus @default(OPEN)

  // ⚡ performance
  lastMessageAt DateTime?
  lastMessage   String?

  messages Message[]
  participants ConversationParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id String @id @default(uuid())

  conversationId String
  userId         String

  roleInConversation ConversationRole

  unreadCount Int @default(0)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id String @id @default(uuid())

  conversationId String
  senderId       String

  content String
  type MessageType @default(TEXT)

  attachments Json?

  deliveredAt DateTime?
  readAt      DateTime?
  isRead Boolean @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

enum ConversationRole {
  CUSTOMER
  ADMIN
  SUPPORT
  SYSTEM
}

enum CouponLogAction {
  APPLIED
  REJECTED
  EXPIRED
  LIMIT_REACHED
  USED
}

//////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////

enum MediaType {
  IMAGE
  VIDEO
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  DELIVERED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PurchaseOrderStatus {
  PENDING
  ORDERED
  RECEIVED
  CANCELLED
}

enum NigerianState {
  ABIA
  ADAMAWA
  AKWA_IBOM
  ANAMBRA
  BAUCHI
  BAYELSA
  BENUE
  BORNO
  CROSS_RIVER
  DELTA
  EBONYI
  EDO
  EKITI
  ENUGU
  GOMBE
  IMO
  JIGAWA
  KADUNA
  KANO
  KATSINA
  KEBBI
  KOGI
  KWARA
  LAGOS
  NASARAWA
  NIGER
  OGUN
  ONDO
  OSUN
  OYO
  PLATEAU
  RIVERS
  SOKOTO
  TARABA
  YOBE
  ZAMFARA
  FCT
}

enum NotificationType {
  ORDER_UPDATE
  PAYMENT_UPDATE
  SHIPPING_UPDATE
  PROMOTION
  SYSTEM
}

enum ConversationStatus {
  OPEN
  CLOSED
  RESOLVED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum StockReservationStatus {
  RESERVED
  CONFIRMED
  RELEASED
  EXPIRED
}



enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}