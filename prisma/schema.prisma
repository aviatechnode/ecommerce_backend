generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////////
// RBAC SYSTEM
//////////////////////////////////////////////////////////

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  parentId    String?
  parent      Role?    @relation("RoleHierarchy", fields: [parentId], references: [id])
  children    Role[]   @relation("RoleHierarchy")

  users       User[]
  rolePermissions RolePermission[]
  rolePermissionGroups RolePermissionGroup[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  resource    String
  action      String

  rolePermissions       RolePermission[]
  permissionAssignments PermissionAssignment[]

  createdAt DateTime @default(now())

  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model PermissionGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  rolePermissionGroups RolePermissionGroup[]
  permissionAssignments PermissionAssignment[]
}

model RolePermissionGroup {
  roleId  String
  groupId String

  role  Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  group PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([roleId, groupId])
}

model PermissionAssignment {
  groupId      String
  permissionId String

  group        PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([groupId, permissionId])
}

//////////////////////////////////////////////////////////
// USER SYSTEM
//////////////////////////////////////////////////////////

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String?
  googleId  String?  @unique

  roleId     String
  role       Role @relation(fields: [roleId], references: [id])

  emailVerified Boolean @default(false)
  verificationToken String? @unique

  resetPasswordToken   String? @unique
  resetPasswordExpires DateTime?
  isOnline Boolean @default(false)
  lastSeen DateTime?

  createdAt DateTime @default(now())

  refreshTokens RefreshToken[]
  cart          Cart?
  addresses     Address[]
  orders        Order[]
  reviews       ProductReview[]
  wishlist      Wishlist?

  idempotencyKeys IdempotencyKey[]

  notifications Notification[]
  auditLogs AuditLog[]
  messages Message[]
  conversationParticipants ConversationParticipant[]
  createdCoupons Coupon[] @relation("CouponCreatedBy")
  updatedCoupons Coupon[] @relation("CouponUpdatedBy")
  couponAuditLogs CouponAuditLog[] @relation("CouponAuditAdmin")

  couponUsages CouponUsage[]
  couponReservations CouponReservation[]
  couponCustomerRules CouponCustomerRule[]
  returnRequests ReturnRequest[]
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  csrfPrevHash String?

  csrfHash   String

  userAgent  String?
  ipAddress  String?

  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////////
// USER PROFILE
//////////////////////////////////////////////////////////

model Address {
  id     String @id @default(uuid())
  userId String

  name   String
  phone  String

  stateId String
  lgaId   String
  city    String

  area        String?
  street      String
  landmark    String?
  fullAddress String @db.Text

  isDefault Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  state State @relation(fields: [stateId], references: [id])
  lga   LGA   @relation(fields: [lgaId], references: [id])

  @@index([userId])
  @@index([stateId, lgaId])
}

model Wishlist {
  id     String @id @default(uuid())
  userId String @unique

  user  User           @relation(fields: [userId], references: [id])
  items WishlistItem[]

  createdAt DateTime @default(now())
}

model WishlistItem {
  id         String @id @default(uuid())
  wishlistId String
  productId  String

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([wishlistId, productId])
}

//////////////////////////////////////////////////////////
// CATALOG
//////////////////////////////////////////////////////////

model Category {
  id   String @id @default(uuid())

  name String
  slug String @unique

  code String @unique
  type String
  level Int @default(0)
  description String?
  imageUrl String?
  sortOrder Int @default(0)

  isActive Boolean @default(true)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products Product[]

  couponCategoryRules CouponCategoryRule[]
}

model Brand {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique
  logoUrl String?
  description String?
  isFeatured Boolean @default(false)

  products Product[]
}

model Product {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  brandId    String
  categoryId String


  isActive Boolean @default(true)
  searchKeywords String?
  isFeatured Boolean @default(false)
  viewCount Int @default(0)
  soldCount Int @default(0)
  

  brand    Brand    @relation(fields: [brandId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  oemNumbers     ProductOEM[]
  variants       ProductVariant[]
  medias         ProductMedia[]
  specifications ProductSpecification[]
  reviews        ProductReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  productFitments ProductFitment[]
  wishlistItems WishlistItem[]
  productSearchIndexes ProductSearchIndex[]
  
  @@index([brandId])
  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
  couponProductRules CouponProductRule[]
}

model ProductVariant {
  id        String @id @default(uuid())
  name String
  sku  String @unique

  price     Decimal @db.Decimal(12,2)
  costPrice Decimal? @db.Decimal(12,2)

  weight Float?
  length Float?
  width  Float?
  height Float?

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  isActive Boolean @default(true)
  compareAtPrice Decimal? @db.Decimal(12,2)
  barcode String? @unique

  inventories ProductInventory[]
  attributes  VariantAttribute[]

  cartItems  CartItem[]
  orderItems OrderItem[]

  inventoryMovements InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  stockReservations StockReservation[]
}

model ProductMedia {
  id        String @id @default(uuid())
  productId String

  url      String
  type     MediaType
  position Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, position])
}

model ProductSpecification {
  id        String @id @default(uuid())
  productId String

  name  String
  value String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductOEM {
  id String @id @default(uuid())

  productId String
  oemNumber String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, oemNumber])
  @@index([oemNumber])
}

model ProductReview {
  id String @id @default(uuid())

  userId    String
  productId String

  title   String?
  rating  Int
  comment String?

  verifiedPurchase Boolean @default(false)
  isApproved       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
}
model ProductSearchIndex {
  id String @id @default(uuid())

  productId String @unique

  searchableText String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////////
// ATTRIBUTES
//////////////////////////////////////////////////////////

model Attribute {
  id   String @id @default(uuid())
  name String
  slug String @unique

  values AttributeValue[]
}

model AttributeValue {
  id          String @id @default(uuid())
  attributeId String

  value String

  attribute Attribute @relation(fields: [attributeId], references: [id])
  variants  VariantAttribute[]
}

model VariantAttribute {
  id String @id @default(uuid())

  variantId String
  valueId   String

  variant ProductVariant @relation(fields: [variantId], references: [id])
  value   AttributeValue @relation(fields: [valueId], references: [id])
  @@unique([variantId, valueId])
}

//////////////////////////////////////////////////////////
// VEHICLE FITMENT
//////////////////////////////////////////////////////////

model VehicleMake {
  id   String @id @default(uuid())
  name String @unique

  models VehicleModel[]
}

model VehicleModel {
  id     String @id @default(uuid())
  makeId String
  name   String

  make VehicleMake @relation(fields: [makeId], references: [id])

  generations VehicleGeneration[]
   @@unique([makeId, name])
}

model VehicleGeneration {
  id      String @id @default(uuid())
  modelId String

  name String

  yearStart Int
  yearEnd   Int?

  model VehicleModel @relation(fields: [modelId], references: [id])

  engines VehicleEngine[]
  @@unique([modelId, name])
}

model VehicleEngine {
  id           String @id @default(uuid())
  generationId String

  engineCode   String
  displacement String?

  generation VehicleGeneration @relation(fields: [generationId], references: [id])

  trims VehicleTrim[]
  @@unique([generationId, engineCode])
}

model VehicleTrim {
  id       String @id @default(uuid())
  engineId String

  name String

  engine VehicleEngine @relation(fields: [engineId], references: [id])

  productFitments ProductFitment[]
  @@unique([engineId, name])
}

model FitmentIndex {
  id String @id @default(uuid())

  productId String

  make  String
  model String
  year  Int

  createdAt DateTime @default(now())

  @@unique([productId, make, model, year])
}

model ProductFitment {
  id String @id @default(uuid())

  productId String
  trimId    String

  notes String?

  product Product     @relation(fields: [productId], references: [id])
  trim    VehicleTrim @relation(fields: [trimId], references: [id])
  @@unique([productId, trimId])
}

//////////////////////////////////////////////////////////
// INVENTORY
//////////////////////////////////////////////////////////



model ProductInventory {
  id String @id @default(uuid())

  variantId   String
  warehouseId String

  stock    Int @default(0)
  reserved Int @default(0)

  threshold Int?

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  @@unique([variantId, warehouseId])
}

model InventoryMovement {
  id String @id @default(uuid())

  variantId   String
  warehouseId String

  type     InventoryMovementType
  quantity Int

  note String?

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())
}

model StockReservation {
  id String @id @default(uuid())

  variantId   String
  warehouseId String
  orderId     String?
  variant ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  quantity Int

  status StockReservationStatus @default(RESERVED)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId, warehouseId])
  @@index([orderId])
}

model Warehouse {
  id   String @id @default(uuid())
  name String

  stateId String
  city    String

  isActive Boolean @default(true)

  state State @relation(fields: [stateId], references: [id])

  inventory ProductInventory[]
  supportedLGAs WarehouseLGA[]

  routes WarehouseRoute[]
  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stateId])
  stockReservations StockReservation[]
}
model WarehouseRoute {
  id String @id @default(uuid())

  warehouseId String
  stateId     String
  lgaId       String?

  priority Int

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  state     State     @relation(fields: [stateId], references: [id])
  lga       LGA?      @relation(fields: [lgaId], references: [id])

  createdAt DateTime @default(now())

  @@index([warehouseId])
  @@index([stateId])
  @@index([lgaId])
}

model WarehouseLGA {
  id String @id @default(uuid())

  warehouseId String
  lgaId       String

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lga       LGA       @relation(fields: [lgaId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, lgaId])
  @@index([lgaId])
}

//////////////////////////////////////////////////////////
// PROCUREMENT
//////////////////////////////////////////////////////////

model Supplier {
  id   String @id @default(uuid())
  name String

  email String?
  phone String?

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id String @id @default(uuid())

  supplierId String

  status PurchaseOrderStatus

  totalAmount Decimal @db.Decimal(12,2)

  supplier Supplier @relation(fields: [supplierId], references: [id])

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
}

model PurchaseOrderItem {
  id String @id @default(uuid())

  purchaseOrderId String
  variantId       String

  quantity  Int
  costPrice Decimal @db.Decimal(12,2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])
}

//////////////////////////////////////////////////////////
// CART
//////////////////////////////////////////////////////////

model Cart {
  id     String @id @default(uuid())
  userId String @unique

  //////////////////////////////////////////////////
  // SHIPPING ESTIMATION
  //////////////////////////////////////////////////

  deliveryStateId String?
  deliveryLgaId   String?

  shippingZoneId String?

  estimatedDeliveryFee Decimal? @db.Decimal(12,2)

  subtotal Decimal? @db.Decimal(12,2)

  grandTotal Decimal? @db.Decimal(12,2)

  //////////////////////////////////////////////////

  user User @relation(fields: [userId], references: [id])

  deliveryState State? @relation(fields: [deliveryStateId], references: [id])
  deliveryLga   LGA?   @relation(fields: [deliveryLgaId], references: [id])

  shippingZone ShippingZone? @relation(fields: [shippingZoneId], references: [id])

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deliveryStateId])
  @@index([deliveryLgaId])
}

model CartItem {
  id String @id @default(uuid())

  cartId    String
  variantId String

  quantity Int

  unitPrice Decimal @db.Decimal(12,2)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

//////////////////////////////////////////////////////////
// ORDERS
//////////////////////////////////////////////////////////

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique

  userId String

  status        OrderStatus
  paymentStatus PaymentStatus

  subtotal    Decimal @db.Decimal(12,2)
  deliveryFee Decimal @db.Decimal(12,2)
  totalAmount Decimal @db.Decimal(12,2)

  currency String @default("NGN")

  couponId String?

  user   User    @relation(fields: [userId], references: [id])
  coupon Coupon? @relation(fields: [couponId], references: [id])

  items  OrderItem[]
  events OrderEvent[]

  address  OrderAddress?
  payment  Payment?

  discountAmount Decimal @default(0)

  // 🔥 NEW: ORDER EXPIRY (CRITICAL)
  expiresAt DateTime?

  // optional but useful for audit/debug
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  couponReservations CouponReservation[]
  shipments Shipment[]

  // 🔥 INDEXES FOR PERFORMANCE (VERY IMPORTANT)
  @@index([status, paymentStatus])
  @@index([expiresAt])
  couponUsages CouponUsage[]
  returnRequests ReturnRequest[]
  stockReservations StockReservation[]
}

model OrderItem {
  id String @id @default(uuid())

  orderId   String
  variantId String

  productName String
  variantName String
  sku         String

  unitPrice Decimal @db.Decimal(12,2)

  quantity Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])
}

model OrderEvent {
  id String @id @default(uuid())

  orderId String

  type String
  message String?

  metadata Json?

  order Order @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
}

model OrderAddress {
  id String @id @default(uuid())

  orderId String @unique

  name  String
  phone String

  stateId String
  lgaId   String
  city    String

  area        String?
  street      String
  landmark    String?
  fullAddress String @db.Text

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  state State @relation(fields: [stateId], references: [id])
  lga   LGA   @relation(fields: [lgaId], references: [id])

  @@index([stateId, lgaId])
}
//////////////////////////////////////////////////////////
// PAYMENTS
//////////////////////////////////////////////////////////
model Payment {
  id String @id @default(uuid())

  orderId String @unique

  reference String @unique

  provider PaymentProvider
  providerReference String?
  gatewayResponse Json?
  failureReason String?

  amount Decimal @db.Decimal(12,2)
  currency String @default("NGN")

  status PaymentStatus

  paidAt DateTime?
  verifiedAt DateTime?

  order Order @relation(fields: [orderId], references: [id])

  refunds Refund[]
  transactions PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reference])
  @@index([providerReference])
  @@index([status])
}
model PaymentTransaction {
  id String @id @default(uuid())

  paymentId String

  eventType String
  payload   Json

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([eventType])
  @@index([createdAt])
}

model Refund {
  id String @id @default(uuid())
  paymentId String

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount Decimal @db.Decimal(12,2)

  orderItemId String?
  quantity Int?

  reason String?

  status RefundStatus @default(PENDING)
  reference String? @unique

  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}


model ReturnRequest {
  id String @id @default(uuid())

  orderId String
  userId  String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status RefundStatus @default(PENDING)

  reason String?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


//////////////////////////////////////////////////////////
// SHIPPING
//////////////////////////////////////////////////////////
model ShipmentEvent {
  id String @id @default(uuid())

  shipmentId String

  status ShipmentStatus

  title String
  description String?

  location String?

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([shipmentId])
}

model ShippingRate {
  id String @id @default(uuid())

  courierId String
  zoneId String

  name String

  minWeight Float @default(0)
  maxWeight Float

  baseFee Decimal @db.Decimal(12,2)

  perKgFee Decimal @db.Decimal(12,2)

  volumetricDivisor Float @default(5000)

  fixedFee Decimal? @db.Decimal(12,2)

  remoteAreaSurcharge Decimal? @db.Decimal(12,2)

  insurancePercent Float @default(0)

  estimatedDaysMin Int
  estimatedDaysMax Int

  supportsCOD Boolean @default(false)

  isActive Boolean @default(true)

  courier Courier @relation(fields: [courierId], references: [id])
  zone ShippingZone @relation(fields: [zoneId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courierId])
  @@index([zoneId])
  shipments Shipment[]
}

model Shipment {
  id String @id @default(uuid())

  orderId String

  courierId String
  shippingRateId String?

  trackingNumber String @unique

  status ShipmentStatus @default(PENDING)

  deliveryFee Decimal @db.Decimal(12,2)
  heavyItemSurcharge Decimal? @db.Decimal(12,2)
  supportsCOD Boolean @default(false)
  fragileFee Decimal? @db.Decimal(12,2)
  sameDayFee Decimal? @db.Decimal(12,2)

  weight Float?

  volumetricWeight Float?

  chargeableWeight Float?

  estimatedDays Int?

  shippedAt DateTime?
  deliveredAt DateTime?

  notes String?

  failedReason String?
  shippingMethod ShippingMethod
  pickupStationId String?
  pickupStation   PickupStation? @relation(fields: [pickupStationId], references: [id])

  courier Courier @relation(fields: [courierId], references: [id])

  shippingRate ShippingRate? @relation(fields: [shippingRateId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ShipmentEvent[]

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
}

model Courier {
  id String @id @default(uuid())

  name String @unique

  phone String?
  email String?
  website String?

  isActive Boolean @default(true)

  rates ShippingRate[]
  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingZoneLGA {
  id String @id @default(uuid())

  zoneId String
  lgaId String

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  lga LGA @relation(fields: [lgaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([zoneId, lgaId])
}

model ShippingZoneState {
  id String @id @default(uuid())

  zoneId String
  stateId String

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([zoneId, stateId])
}

model ShippingZone {
  id String @id @default(uuid())

  name String @unique
  code String @unique

  description String?

  isActive Boolean @default(true)

  states ShippingZoneState[]
  lgas ShippingZoneLGA[]

  rates ShippingRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carts Cart[]
}

model PickupStation {
  id String @id @default(uuid())

  name String

  stateId String
  lgaId   String

  address String @db.Text

  landmark String?
  phone    String?

  latitude  Float?
  longitude Float?

  openingHours String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////

  state State @relation(fields: [stateId], references: [id])
  lga   LGA   @relation(fields: [lgaId], references: [id])

  shipments Shipment[]

  //////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////

  @@index([stateId])
  @@index([lgaId])
  @@index([isActive])
  @@index([stateId, lgaId])
}

model State {
  id   String @id @default(uuid())
  name String @unique
  latitude  Float?
  longitude Float?

  lgas LGA[]

  warehouses Warehouse[]

  orderAddresses OrderAddress[]
  addresses      Address[]
  warehouseRoutes WarehouseRoute[]

  shippingZoneStates ShippingZoneState[]

  carts Cart[]

  pickupStations PickupStation[]
}

model LGA {
  id   String @id @default(uuid())
  name String
  latitude  Float?
  longitude Float?

  stateId String
  state   State @relation(fields: [stateId], references: [id], onDelete: Cascade)

  warehouses WarehouseLGA[]

  orderAddresses OrderAddress[]
  addresses      Address[]
  warehouseRoutes WarehouseRoute[]
  @@unique([stateId, name])
  @@index([stateId])
  shippingZoneLGAs ShippingZoneLGA[]
  carts Cart[]
  pickupStations PickupStation[]
}

//////////////////////////////////////////////////////////
// MARKETING (PRODUCTION GRADE)
//////////////////////////////////////////////////////////
model Coupon {
  id String @id @default(uuid())

  //////////////////////////////////////////////////////////
  // Identity
  //////////////////////////////////////////////////////////

  code        String @unique
  name        String
  description String?

  //////////////////////////////////////////////////////////
  // Lifecycle
  //////////////////////////////////////////////////////////

  status      CouponStatus @default(DRAFT)
  isActive    Boolean      @default(true)

  startsAt    DateTime?
  expiresAt   DateTime?

  archivedAt  DateTime?
  deletedAt   DateTime?

  //////////////////////////////////////////////////////////
  // Discount Engine
  //////////////////////////////////////////////////////////

  type        CouponType
  version Int @default(1)
  scope       CouponScope @default(ORDER_TOTAL)
  createdById String?
  updatedById String?

  createdBy User? @relation("CouponCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("CouponUpdatedBy", fields: [updatedById], references: [id])
  priority Int @default(0)
  internalNotes String?

  /*
  FIXED_AMOUNT => amountOff required
  PERCENTAGE   => percentOff required
  FREE_SHIPPING => freeShipping = true
  */

  amountOff   Decimal? @db.Decimal(12,2)
  percentOff  Decimal? @db.Decimal(5,2)

  /*
  Example:
  20% OFF capped at ₦15,000
  */

  maxDiscountAmount Decimal? @db.Decimal(12,2)

  freeShipping Boolean @default(false)

  //////////////////////////////////////////////////////////
  // Qualification Rules
  //////////////////////////////////////////////////////////

  minimumOrderAmount Decimal? @db.Decimal(12,2)
  minimumItemQuantity Int?

  firstOrderOnly Boolean @default(false)

  appliesTo CouponAppliesTo @default(ALL_PRODUCTS)

  //////////////////////////////////////////////////////////
  // Abuse Prevention
  //////////////////////////////////////////////////////////

  usageLimit   Int?
  usedCount    Int @default(0)

  perUserLimit Int @default(1)

  /*
  Prevent stacking with other promotions
  */

  isStackable Boolean @default(false)
  excludeSaleItems Boolean @default(false)
  /*
  internal anti-fraud metadata
  */

  metadata Json?

  //////////////////////////////////////////////////////////
  // Audit
  //////////////////////////////////////////////////////////

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////////////
  // Relations
  //////////////////////////////////////////////////////////

  productRules   CouponProductRule[]
  categoryRules  CouponCategoryRule[]
  customerRules  CouponCustomerRule[]

  reservations   CouponReservation[]
  usages         CouponUsage[]

  orders         Order[]

  @@index([status, isActive])
  @@index([startsAt, expiresAt])
  @@index([usedCount])
  couponAuditLogs CouponAuditLog[]
}

//////////////////////////////////////////////////////////
// PRODUCT TARGETING
//////////////////////////////////////////////////////////

model CouponProductRule {
  id String @id @default(uuid())

  couponId  String
  productId String

  createdAt DateTime @default(now())

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
  @@index([productId])
}

//////////////////////////////////////////////////////////
// CATEGORY TARGETING
//////////////////////////////////////////////////////////

model CouponCategoryRule {
  id String @id @default(uuid())

  couponId   String
  categoryId String

  createdAt DateTime @default(now())

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
  @@index([categoryId])
}

//////////////////////////////////////////////////////////
// CUSTOMER TARGETING
//////////////////////////////////////////////////////////

model CouponCustomerRule {
  id String @id @default(uuid())

  couponId String
  userId   String

  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId])
}

//////////////////////////////////////////////////////////
// RESERVATION LAYER
//////////////////////////////////////////////////////////

model CouponReservation {
  id String @id @default(uuid())

  couponId String
  userId   String
  orderId  String

  status CouponReservationStatus @default(ACTIVE)

  reservedDiscountAmount Decimal? @db.Decimal(12,2)

  expiresAt DateTime
  consumedAt DateTime?
  releasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId, status])

  @@index([couponId, expiresAt])
  @@index([status, expiresAt])
  @@index([orderId])
}

//////////////////////////////////////////////////////////
// IMMUTABLE USAGE HISTORY
//////////////////////////////////////////////////////////
model CouponUsage {
  id String @id @default(uuid())

  couponId String
  userId   String
  orderId  String @unique

  status CouponUsageStatus @default(SUCCESS)

  discountAmount Decimal @db.Decimal(12,2)
  orderAmount Decimal? @db.Decimal(12,2)
  refundedAmount Decimal? @db.Decimal(12,2)

  usedAt DateTime @default(now())
  refundedAt DateTime?
  reversedAt DateTime?

  metadata Json?

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([couponId])
  @@index([userId])
  @@index([status])
  @@index([usedAt])
}

model CouponAuditLog {
  id String @id @default(uuid())

  couponId String
  adminId  String?

  action CouponLogAction

  message String?
  metadata Json?

  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  admin User? @relation("CouponAuditAdmin", fields: [adminId], references: [id])

  @@index([couponId])
  @@index([adminId])
  @@index([createdAt])
}
//////////////////////////////////////////////////////////
// OPERATIONS
//////////////////////////////////////////////////////////

model IdempotencyKey {
  id String @id @default(uuid())

  key String @unique

  userId String

  response Json?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(uuid())

  userId String

  action   String
  entity   String
  entityId String?
  ipAddress String?
  userAgent String?
  metadata Json?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

//////////////////////////////
// NOTIFICATIONS
//////////////////////////////

model Notification {
  id String @id @default(uuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType
  title String
  message String

  isRead Boolean @default(false)

  entityType String?   // ORDER, PAYMENT, SHIPMENT, SYSTEM
  entityId   String?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([entityType, entityId])
}

model DashboardSnapshot {
  id String @id @default(uuid())

  date DateTime @unique

  totalRevenue Decimal @db.Decimal(12,2)
  totalOrders  Int
  totalUsers   Int

  createdAt DateTime @default(now())
}


//////////////////////////////
// Chat
//////////////////////////////

model Conversation {
  id String @id @default(uuid())

  status ConversationStatus @default(OPEN)

  // ⚡ performance
  lastMessageAt DateTime?
  lastMessage   String?

  messages Message[]
  participants ConversationParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id String @id @default(uuid())

  conversationId String
  userId         String

  roleInConversation ConversationRole

  unreadCount Int @default(0)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id String @id @default(uuid())

  conversationId String
  senderId       String

  content String
  type MessageType @default(TEXT)

  attachments Json?

  deliveredAt DateTime?
  readAt      DateTime?
  isRead Boolean @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}
model Feedback {
  id                String   @id @default(uuid())
  userName          String?
  email             String
  phoneNumber       String?
  productName       String
  productNumber     String?
  usageDuration     String?
  buyAgain          String?
  buyingExperience  Int     @default(0)
  concern           String?

  ratings           FeedbackRating[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model FeedbackRating {
  id          String    @id @default(uuid())
  feedbackId  String
  criteria    String
  score       Int

  feedback    Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
}

enum ConversationRole {
  CUSTOMER
  ADMIN
  SUPPORT
  SYSTEM
}

enum CouponLogAction {
  APPLIED
  REJECTED
  EXPIRED
  LIMIT_REACHED
  USED
}

